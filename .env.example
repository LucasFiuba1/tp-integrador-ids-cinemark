# Copiar este archivo a .env y completar los valores. .env NO se sube al repo.

# --- Backend ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DB_HOST=localhost
DB_PORT=3306
DB_USER=cine
DB_PASSWORD=cine
DB_NAME=cine_paradiso
# true para bases remotas que requieren TLS verificado; false para MySQL local.
DB_SSL=false
TMDB_API_KEY=
# Minutos que una compra queda pendiente antes de liberar las butacas
MINUTOS_RESERVA=10
# Horas antes de la función hasta las que se permite cancelar
HORAS_LIMITE_CANCELACION=2

# SMTP para emails de compra
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
FRONTEND_SECRET_KEY=cambiar-por-otra-clave
BACKEND_URL=http://localhost:5000
# Segundos por petición. En Render Free puede usarse 90 por el arranque en frío.
BACKEND_TIMEOUT=5

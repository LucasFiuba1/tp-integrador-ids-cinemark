# Copiar este archivo a .env y completar los valores propios. NO compartir el .env.
# Guías: docs/entorno.md (variables y claves) y docs/deploy.md (hosting gratuito).
# Si también se usa init.sh --db, el archivo debe ser compatible con Bash.

# --- Backend ---
# Generar una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No conservar este placeholder ni regenerar la clave en cada arranque.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# El usuario y la base deben existir; estos valores son ejemplos locales.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cine
DB_PASSWORD=cine
DB_NAME=cine_paradiso
# true para bases remotas que requieren TLS verificado; false para MySQL local.
DB_SSL=false
# TMDB: API key v3, NO el API Read Access Token. Necesaria para importar películas.
TMDB_API_KEY=
# Minutos que una compra queda pendiente antes de liberar las butacas
MINUTOS_RESERVA=10
# Límite previsto de cancelación; el flujo completo todavía no está implementado.
HORAS_LIMITE_CANCELACION=2

# SMTP reservado para emails de compra: envío todavía no implementado.
# Gmail requiere contraseña de aplicación, no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend ---
# Generar OTRA clave con el mismo comando; debe ser distinta de SECRET_KEY.
FRONTEND_SECRET_KEY=cambiar-por-otra-clave
# Base de la API, sin /api al final. En hosting usar la URL HTTPS real del backend.
BACKEND_URL=http://localhost:5000
# Segundos por petición. En Render Free puede usarse 90 por el arranque en frío.
BACKEND_TIMEOUT=5

# Base MySQL de pruebas (SCRUM-78). Copiar a .env.test (no se sube) y completar con un MySQL local.
# Las pruebas *_mysql.py BORRAN esta base y la vuelven a crear con schema.sql + seed.sql en cada corrida:
# el nombre tiene que terminar en _test y ser distinto del DB_NAME del .env. Nunca apuntar a producción.
# Sin este archivo (o sin PRUEBAS_DB_PORT) esas pruebas se saltean y el resto de la suite corre igual.
PRUEBAS_DB_HOST=127.0.0.1
PRUEBAS_DB_PORT=3306
PRUEBAS_DB_USER=root
PRUEBAS_DB_PASSWORD=
PRUEBAS_DB_NAME=cine_paradiso_test
